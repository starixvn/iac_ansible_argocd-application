apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: redis-sentinel-{{env}}-{{system}}
  namespace: argocd
  labels:
    name: redis-sentinel-{{env}}-{{system}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ info[org][env]["cluster"] }}"
    namespace: redis-sentinel-{{system}}
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: redis
    targetRevision: HEAD
    helm:
      valueFiles:
        - value.d/values-{{org}}-{{env}}.yml
      releaseName: redis-sentinel-{{env}}-{{system}}

  syncPolicy:
    automated:
      prune: false
      selfHeal: true
      allowEmpty: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m