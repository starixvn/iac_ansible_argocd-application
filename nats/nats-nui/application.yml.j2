apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: nats-nui-{{team}}-{{env}}
  namespace: argocd
  labels:
    name: nats-nui-{{team}}-{{env}}
    env: {{env}}
    org: {{org}}
    team: {{team}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
    namespace: nats-{{team}}
  project: "{{ argo_project | default('default') }}"
  sources:
  - repoURL: "{{repoURL}}"
    path: "nats/nats-nui/{{ chartVersion }}"
    targetRevision: HEAD
    helm:
      releaseName: nats-nui-{{team}}-{{env}}
      valueFiles:
        - $values/nats/nats-nui/value.d/values-{{team}}-{{env}}.yaml
      parameters:
      - name: "image.repository"
        value: "{{ info[org][env]['hub'] }}/base/nats-nui/nui"
  - repoURL: "{{values_repoURL}}"
    targetRevision: HEAD
    ref: values

  syncPolicy:
    automated:
      prune: false
      selfHeal: true
      allowEmpty: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m