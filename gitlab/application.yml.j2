apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gitlab-{{org}}-{{env}}
  namespace: argocd
  labels:
    name: gitlab-{{org}}-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "https://kubernetes.default.svc"
    namespace: gitlab-server
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: gitlab
    targetRevision: HEAD
    helm:
      releaseName: gitlab-{{org}}-{{env}}
      valuesObject:
        global:
          nodeSelector:
            gitlab-server: "yes"
          hosts:
            domain: "{{ info[org][env]['ingressDomain'] }}"
            gitlab:
              name: "git21.{{ info[org][env]['ingressDomain'] }}"
          ingress:
            provider: "nginx"
            class: "nginx" 
            tls:
              enabled: true
              #secretName: "gitlab-lumi-lumprod-wildcard-tls"
          appConfig:
            ldap:
              preventSignin: false
              servers:
                main:
                  label: 'LDAP'
                  host: '10.10.50.102'
                  port: 389
                  uid: 'sAMAccountName'
                  bind_dn: 'CN=LDAP Reader,OU=ServicesAccounts,OU=UsersGroups,OU=IT,OU=ServersLabs,OU=LUMI,DC=luminet,DC=vn'
                  base: 'OU=LUMI,DC=luminet,DC=vn'
                  password:
                    secret: 'gitlab-lumprod-ldap-password'
                    key: 'password'
                  verify_certificates: false
                  active_directory: true
        nginx-ingres:
          enabled: true
        gitlab:
          gitaly:
            persistence:
              #storageClass: local-path
              storageClass: nfs-client
              size: 40Gi
          gitlab-shell:
            enabled: true
        minio:
          persistence:
            #storageClass: local-path
            storageClass: nfs-client
            size: 50Gi
          nodeSelector:
            gitlab-server: "yes"
        postgresql:
          primary:
            persistence:
              #storageClass: local-path
              storageClass: nfs-client
              size: 11Gi
            nodeSelector:
              gitlab-server: "yes"
        redis:
          master:
            persistence:
              #storageClass: local-path
              storageClass: nfs-client
              size: 10Gi
            nodeSelector:
              gitlab-server: "yes"


  syncPolicy:
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m