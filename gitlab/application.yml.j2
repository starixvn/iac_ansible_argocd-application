apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gitlab-{{org}}-{{env}}
  namespace: argocd
  labels:
    name: gitlab-{{org}}-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "https://kubernetes.default.svc"
    namespace: gitlab-server
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: gitlab
    targetRevision: HEAD
    helm:
      releaseName: gitlab-{{org}}-{{env}}
      valuesObject:
        upgradeCheck:
          enabled: false
        global:
          tolerations:
          - key: "cattle.io/os"
            value: "gitlab"
            effect: "NoSchedule"
          nodeSelector:
            gitlab-server: "yes"
          hosts:
            domain: lumigame.com
            https: false
            gitlab:
              name: gitgd.lumigame.com
          edition: ce
          kas:
            enabled: false
          registry:
            enabled: false
          time_zone: "Asia/Bangkok"
          ingress:
            enabled: true
            class: "haproxy"
            configureCertmanager: false
            tls:
              enabled: false
        nginx-ingress:
          enabled: false
        certmanager:
          installCRDs: false
          install: false
        gitlab-runner:
          install: false
        gitlab:
          toolbox:
            enabled: false
          gitaly:
            persistence:
              storageClass: local-path
              size: 30Gi
        minio:
          persistence:
            storageClass: local-path
            size: 45Gi
          nodeSelector:
            gitlab-server: "yes"
        postgresql:
          primary:
            persistence:
              storageClass: local-path
              size: 8Gi
            nodeSelector:
              gitlab-server: "yes"
        redis:
          master:
            persistence:
              storageClass: local-path
              size: 5Gi
            nodeSelector:
              gitlab-server: "yes"
        prometheus:
          install: false
        

  syncPolicy:
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m