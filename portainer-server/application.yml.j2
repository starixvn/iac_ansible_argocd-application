apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: portainer-server-{{env}}
  namespace: argocd
  labels:
    name: portainer-server-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ org[env]["cluster"] }}"
    namespace: portainer
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: portainer-server
    targetRevision: HEAD
    helm:
      releaseName: portainer-server-{{env}}
      valuesObject:
        image:
          repository: "{{ org[env]['hub'] }}/base/portainer"
          tag: server-2.19.4
          pullPolicy: Always
        service:
          type: ClusterIP
        ingress:
          enabled: true
          ingressClassName: "haproxy"
          hosts:
            - host: "portainer-k3s.{{ org[env]['ingressDomain'] }}"
              paths:
              - path: "/"
                pathType: "Prefix"
        persistence:
          storageClass: "{{ org[env]['storageClass'] }}"

  syncPolicy:
    automated:
      prune: false
      selfHeal: true
      allowEmpty: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m