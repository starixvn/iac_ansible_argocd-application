apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gitlab-runner-{{org}}-{{runnerType}}
  namespace: argocd
  labels:
    name: gitlab-runner-{{org}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
    namespace: gitlab-runner
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: gitlab-runner/16.2.2
    targetRevision: HEAD
    helm:
      valueFiles:
        - value.d/{{runnerType}}-{{org}}-{{env}}.yml
      releaseName: gitlab-runner-{{org}}-{{runnerType}}


  syncPolicy:
    automated:
      prune: false
      selfHeal: true
      allowEmpty: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m