apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: vault-{{env}}
  namespace: argocd
  labels:
    name: vault-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ info[org][env]["cluster"] }}"
    namespace: vault
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: vault-cluster
    targetRevision: HEAD
    helm:
      releaseName: vault-{{env}}
      valuesObject:
        image:
          repository: "hashicorp/vault-k8s"
          tag: "1.3.1"
          pullPolicy: Always
        service:
          type: ClusterIP
        ingress:
          enabled: true
          ingressClassName: "haproxy"
          hosts:
            - host: "vault-k3s.{{ info[org][env]['ingressDomain'] }}"
              paths:
              - path: "/"
                pathType: "Prefix"
          annotations:
            ingress.kubernetes.io/ssl-redirect: "true"
        persistence:
          storageClass: "longhorn-stricted"
          size: "10Gi"

  syncPolicy:
    automated:
      prune: false
      selfHeal: true
      allowEmpty: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m