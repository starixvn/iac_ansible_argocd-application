apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: vault-{{env}}
  namespace: argocd
  labels:
    name: vault-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
    namespace: vault
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: vault/{{chartVersion}}
    targetRevision: HEAD
    helm:
      releaseName: vault-{{env}}
      valueFiles:
        - value.d/values-{{org}}-{{env}}.yaml
      valuesObject:
        global:
          enabled: true
          tlsDisable: true
        injector:
          enabled: true
          image:
            repository: "{{ info[org][env]['hub'] }}/base/hashicorp/vault-k8s"
          agentImage:
            repository: "{{ info[org][env]['hub'] }}/base/hashicorp/vault"
          
        server:
          # Use the Enterprise Image
          image:
            repository: "{{ info[org][env]['hub'] }}/base/hashicorp/vault"

  syncPolicy:
    automated:
      prune: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m