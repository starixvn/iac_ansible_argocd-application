apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: trivy-dojo-report-operator-{{team}}-{{env}}
  namespace: argocd
  labels:
    name: trivy-operator-{{team}}-{{env}}
    env: {{env}}
    org: {{org}}
    team: {{team}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
    namespace: trivy-operator-{{team}}
  project: "{{ argo_project | default('default') }}"
  sources:
  - repoURL: "{{repoURL}}"
    path: trivy-stack/trivy-dojo-report-operator/{{chartVersion}}
    targetRevision: HEAD
    helm:
      releaseName: trivy-dojo-report-operator-{{team}}-{{env}}
      valueFiles:
        - $values/trivy-stack/trivy-dojo-report-operator/value.d/values-{{team}}-{{env}}.yaml
      parameters:
      - name: "operator.trivyDojoReportOperator.env.defectDojoEngagementName"
        value: "trivy-dojo-report-operator-{{team}}-{{env}}"
      - name: "operator.trivyDojoReportOperator.env.defectDojoEngagementName"
        value: "trivy-{{team}}-{{env}}"
      # - name: "global.image.registry"
      #   value: "{{ info[org][env]['hub'] }}/base"
      valuesObject:

  - repoURL: "{{values_repoURL}}"
    targetRevision: HEAD
    ref: values

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
      allowEmpty: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m