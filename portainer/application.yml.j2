apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: portainer-server-{{team}}-{{env}}
  namespace: argocd
  labels:
    name: portainer-server-{{team}}-{{env}}
    env: {{env}}
    org: {{org}}
    team: {{team}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
    namespace: portainer
  project: "{{ argo_project | default('default') }}"
  sources:
  - repoURL: "{{repoURL}}"
    path: portainer/{{chartVersion}}
    targetRevision: HEAD
    helm:
      releaseName: portainer-server-{{team}}-{{env}}
      valueFiles:
        - $values/portainer/value.d/values-{{team}}-{{env}}.yaml
      parameters:
      - name: "image.repository"
        value: "harbor.byb6181.com/vn-st/base/portainer/portainer-ce"
      valuesObject:
        image:
          repository: "{{ info[org][env]['hub'] }}/base/portainer"

  - repoURL: "{{values_repoURL}}"
    targetRevision: HEAD
    ref: values

  syncPolicy:
    automated:
      prune: false
      selfHeal: true
      allowEmpty: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m