apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: minio-operator-{{team}}-{{env}}
  namespace: argocd
  labels:
    name: "minio-operator-{{team}}-{{env}}"
    env: {{env}}
    org: {{org}}
    team: {{team}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
{% if team == 'backup' %}
    namespace: minio
{% else %}
    namespace: minio-{{tenantName}}
{% endif %}
  project: default
  sources:
  - repoURL: "{{repoURL}}"
    path: "minio/operator/{{ chartVersion }}"
    targetRevision: HEAD
    helm:
      releaseName: minio-operator-{{team}}-{{env}}
      valueFiles:
      - $values/minio/v2/operator/value.d/values-{{team}}-{{env}}.yaml
      parameters: 
      - name: "operator.image.repository"
        value: "{{ info[org][env]['hub'] }}/base/minio/operator"
      - name: "operator.image.sidecarImage.repository"
        value: "{{ info[org][env]['hub'] }}/base/minio/operator-sidecar"
      valuesObject:
        tenant:
          name: {{tenantName}}
          
  - repoURL: "{{values_repoURL}}"
    targetRevision: HEAD
    ref: values
  
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m