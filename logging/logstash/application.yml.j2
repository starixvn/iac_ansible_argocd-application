apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: logstash-{{env}}
  namespace: argocd
  labels:
    name: logstash-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
    namespace: logging
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: logging/logstash/{{helmVersion}}
    targetRevision: HEAD
    helm:
      releaseName: logstash-{{env}}
      valueFiles:
        - value.d/values-{{org}}-{{env}}.yaml
      valuesObject:
        image: "{{ info[org][env]['hub'] }}/base/logstash/logstash"
        # image: "{{ info[org][env]['hub'] }}/base/opensearchproject/logstash-opensearch"
        logstashPattern:
          pattern.conf: |
            HAPROXYGW %{IP:client_ip}:%{INT:client_port} \[%{HAPROXYDATE:accept_date}\] %{NOTSPACE:frontend_name} %{NOTSPACE:backend_name}/%{NOTSPACE:server_name} %{INT:time_queue}/%{INT:time_backend_connect}/%{NOTSPACE:time_duration} %{NOTSPACE:bytes_read} %{NOTSPACE:termination_state} %{INT:actconn}/%{INT:feconn}/%{INT:beconn}/%{INT:srvconn}/%{NOTSPACE:retries} %{INT:srv_queue}/%{INT:backend_queue}

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m