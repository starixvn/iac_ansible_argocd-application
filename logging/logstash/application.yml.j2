apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: logstash-{{env}}
  namespace: argocd
  labels:
    name: logstash-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
    namespace: logging
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: logging/logstash/{{helmVersion}}
    targetRevision: HEAD
    helm:
      releaseName: logstash-{{env}}
      valueFiles:
        - value.d/values-{{org}}-{{env}}.yaml
      valuesObject:
        image: "{{ info[org][env]['hub'] }}/base/logstash/logstash"
        # image: "{{ info[org][env]['hub'] }}/base/opensearchproject/logstash-opensearch"

        httpPort: 9600
        extraPorts:
          - name: httplog
            containerPort: 8080
          - name: beats
            containerPort: 5000
          - name: tcp
            containerPort: 5044
          # - name: beats
          #   containerPort: 5001

        nodeSelector: 
          nexops-tools: "yes"

        service:
          type: NodePort
          ports:
            - name: beats
              nodePort: 30500
              port: 5000
              protocol: TCP
              targetPort: 5000
            - name: httplog
              port: 8080
              protocol: TCP
              targetPort: 8080
            - name: http
              port: 9600
              protocol: TCP
              targetPort: 9600
            - name: tcp
              nodePort: 30504
              port: 5044
              protocol: TCP
              targetPort: 5044
          # annotations: {}
          # type: ClusterIP
          # loadBalancerIP: ""
          # ports:
          #   - name: beats
          #     port: 5044
          #     protocol: TCP
          #     targetPort: 5044
          #   - name: http
          #     port: 8080
          #     protocol: TCP
          #     targetPort: 8080

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m