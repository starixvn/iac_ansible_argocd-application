apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: logstash-{{env}}
  namespace: argocd
  labels:
    name: logstash-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ info[org][env]['cluster'] }}"
    namespace: logging
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: opensearch/logstash
    targetRevision: HEAD
    helm:
      releaseName: logstash-{{env}}
      valuesObject:
        logstashConfig:
          logstash.yml: |
            http.host: "0.0.0.0"

        logstashPipeline:
          generic.conf: |
            input {

              http {
                port => 8080
                add_field => { "[@metadata][input-http]" => "" }
              }
              beats {
                port => 5000
              }
              tcp {
                port => 5044
                codec => json
              }

            }

          # vault_input.conf: |
          #   input {}

          vault_filter.conf: |
            filter {
              if [host] =~ /vault-cluster/ {
                json {
                    source => "message"
                  }
                mutate {
                  add_tag => ["vault-cluster-server"]
                }
              }
              else if [host] =~ /vault/ {
                json {
                    source => "message"
                  }
                mutate {
                  add_tag => ["vault-server"]
                }
              }
            }


          main_output.conf: |
            output {

              if "vault-server" in [tags] {
                opensearch {
                  hosts => ["https://opensearch-cluster-master:9200"]
                  user => "logstash"
                  password => "logstash"
                  ssl => true
                  ssl_certificate_verification => false
                  index => "logstash-vault-audit-local-%{+YYYY.MM.dd}"
                }         
              }
              
              else if "vault-cluster-server" in [tags] {
                opensearch {
                  hosts => ["https://opensearch-cluster-master:9200"]
                  user => "logstash"
                  password => "logstash"
                  ssl => true
                  ssl_certificate_verification => false
                  index => "logstash-vault-cluster-audit-local-%{+YYYY.MM.dd}"
                }         
              }

              else {
                opensearch {
                  hosts => ["https://opensearch-cluster-master:9200"]
                  user => "logstash"
                  password => "logstash"
                  ssl => true
                  ssl_certificate_verification => false
                  index => "logstash-unknown-%{+YYYY.MM.dd}"
                }        
              }

            }
            


        logstashJavaOpts: "-Xmx3g -Xms3g"
        resources:
          requests:
            cpu: "100m"
            memory: "4096Mi"
          limits:
            cpu: "1000m"
            memory: "4096Mi"
        image: "{{ info[org][env]['hub'] }}/base/elk/logstash"
        # image: "docker.elastic.co/logstash/logstash"
        imageTag: "7.17.6"
        # imageTag: "8.5.1"

        httpPort: 9600
        extraPorts:
          - name: httplog
            containerPort: 8080
          - name: beats
            containerPort: 5000
          - name: tcp
            containerPort: 5044
          # - name: beats
          #   containerPort: 5001

        nodeSelector: 
          nexops-tools: "yes"

        service:
          type: ClusterIP
          ports:
            - name: beats
              port: 5000
              protocol: TCP
              targetPort: 5000
            - name: httplog
              port: 8080
              protocol: TCP
              targetPort: 8080
            - name: http
              port: 9600
              protocol: TCP
              targetPort: 9600
            - name: tcp
              port: 5044
              protocol: TCP
              targetPort: 5044
          # annotations: {}
          # type: ClusterIP
          # loadBalancerIP: ""
          # ports:
          #   - name: beats
          #     port: 5044
          #     protocol: TCP
          #     targetPort: 5044
          #   - name: http
          #     port: 8080
          #     protocol: TCP
          #     targetPort: 8080

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m