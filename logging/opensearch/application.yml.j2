apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: opensearch-{{env}}
  namespace: logging
  labels:
    name: opensearch-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    server: "{{ info[org][env]["cluster"] }}"
    namespace: logging
  project: default
  source:
    repoURL: "{{repoURL}}"
    path: opensearch/opensearch
    targetRevision: HEAD
    helm:
      releaseName: opensearch-{{env}}
      valuesObject:
        singleNode: true
        extraEnvs:
          - name: OPENSEARCH_INITIAL_ADMIN_PASSWORD
            value: Y8cY3sn7hCwSmJLff2U7fkNG
        image:
          repository: "hub.nexdev.net/base/opensearchproject/opensearch"
          tag: "2.13.0"
        persistence:
          enabled: true
        accessModes:
          - ReadWriteOnce
        size: 20Gi
        nodeSelector:
          nexops-tools: "yes"
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m