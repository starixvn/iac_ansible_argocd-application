apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: haproxy-ingress-{{env}}
  namespace: argocd
  labels:
    name: haproxy-ingress-{{env}}
    env: {{env}}
    org: {{org}}
spec:
  destination:
    namespace: haproxy-ingress
    server: "{{ info[org][env]['cluster'] }}"
  project: default
  source:
    helm:
      releaseName: haproxy-ingress-{{env}}
      parameters:
{% if env == "local" %}
      - name: "controller.service.type"
        value: NodePort
{% else %}
      - name: "controller.service.type"
        value: LoadBalancer
{% endif %}
      valuesObject:
        controller:
{% if enable_gitlab_shell is defined %}
          service:
            tcpPorts:
              - name: ssh
                port: 22
                targetPort: 22
          extraArgs:
            - --configmap-tcp-services=gitlab-server/gitlab-server-haproxy-tcp
{% endif %}
          config:
            timeout-connect: "5s"
            scale-server-slots: "7"
            maxconn: "20000"
            stats-config-snippet: |
{% if org == "starix" %}
              stats auth nexcel:NexOps!QAZ
{% elif org == "lumi" %}
              stats auth lumi:lum!onRock
{% endif %}
              stats refresh 300s
              stats show-legends
              stats show-node
              stats show-modules
            forwarded-for: "true"
            dontlognull: "true"
{% if org == "lumi" and env == "local" %}
            syslog-server: "address:10.10.50.121, port:30514, facility:local1"
{% endif %}
{% if org == "starix" and setTLS is defined %}
            ssl-certificate: "haproxy-ingress/nexdev-crt"
{% endif %}
{% if org == "lumi" and setTLS is defined %}
            ssl-certificate: "haproxy-ingress/lumigame-cert"
{% endif %}
    path: kubernetes-ingress-ori
    repoURL: "{{ repoURL }}"
    targetRevision: HEAD
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
      allowEmpty: true
    syncOptions:
    - CreateNamespace=true
    retry:
      limit: 5 # number of failed sync attempt retries; unlimited number of attempts if less than 0
      backoff:
        duration: 5s # the amount to back off. Default unit is seconds, but could also be a duration (e.g. "2m", "1h")
        factor: 2 # a factor to multiply the base duration after each failed retry
        maxDuration: 3m # the maximum amount of time allowed for the backoff strategy    
